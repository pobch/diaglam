{
  "name": "react-diagram",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/cypress": "^10.1.3",
    "@testing-library/jest-dom": "^5.16.4",
    "@types/jest": "^27.0.1",
    "@types/node": "^18.0.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cypress": "^16.1.1",
    "cypress-visual-regression": "^6.0.1",
    "eslint-plugin-cypress": "^2.12.1",
    "perfect-freehand": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-scripts": "5.0.1",
    "roughjs": "^4.5.2",
    "typescript": "^4.7.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "visual:baseline": "cypress run --e2e --browser electron --expose visualRegressionType=base",
    "visual:test": "cypress run --e2e --browser electron --expose visualRegressionType=regression",
    "cypress:open": "cypress open --e2e --browser electron",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {}
}
