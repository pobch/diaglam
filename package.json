{
  "name": "react-diagram",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "dependencies": {
    "perfect-freehand": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "roughjs": "^4.5.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "pnpm run lint --fix",
    "visual:baseline": "cypress run --e2e --browser electron --expose visualRegressionType=base",
    "visual:test": "cypress run --e2e --browser electron --expose visualRegressionType=regression",
    "cypress:open": "cypress open --e2e --browser electron"
  },
  "devDependencies": {
    "@testing-library/cypress": "^10.1.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "cypress": "^16.1.1",
    "cypress-visual-regression": "^6.0.1",
    "eslint-plugin-cypress": "^7.0.2",
    "oxlint": "^1.87.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
